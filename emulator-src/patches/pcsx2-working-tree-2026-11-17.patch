+// SPDX-License-Identifier: GPL-3.0+
+// PS2Net: plays a game's own local multiplayer online, in lockstep. Not part of upstream PCSX2.
+// Design: digimon-online/docs/DESIGN.md. Needs proper testing; the test log is in digimon-online/docs/TESTS.md.
+//
+// Every PC runs the same game from power-on with the same settings. Once per emulated frame (vsync) each PC reads
+// its own controller (PCSX2 pad 1), sends it to the host tagged with "frame now + delay", and waits until the host
+// has sent the inputs of ALL players for the current frame. Player k's input then drives emulated controller slot k.
+// The host is player 1 and relays (star network over UDP). Memory hashes are compared to prove the PCs stay equal.
+
+#include "PS2Net/PS2Net.h"
+
+#include "Config.h"
+#include "Counters.h"
+#include "GS/GS.h"
+#include "GS/GSPresentView.h"
+#include "GS.h"
+#include "Host.h"
+#include "Memory.h"
+#include "MTGS.h"
+#include "PerformanceMetrics.h"
+#include "SIO/Pad/Pad.h"
+#include "SIO/Pad/PadDualshock2.h"
+#include "VMManager.h"
+#include "ps2/BiosTools.h"
+
+#include "common/Console.h"
+#include "common/FileSystem.h"
+#include "common/MemorySettingsInterface.h"
+#include "common/Path.h"
+#include "common/SettingsWrapper.h"
+#include "common/StringUtil.h"
+
+#include "fmt/format.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <random>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#pragma comment(lib, "ws2_32")
+#else
+#error "PS2Net: only the Windows socket code is written so far"
+#endif
+
+namespace PS2Net
+{
+	namespace
+	{
+		constexpr u32 kMagic = 0x314E3250; // "P2N1"
+		constexpr u32 kProtocol = 4; // 2: layout + patch hash; 3: screen; 4: one-way inputs (partial SETs) + timed start
+		constexpr u8 kNoSlot = 0xFF; // player not used by this controller layout
+		constexpr u32 kMaxPlayers = 4;
+		constexpr u32 kRing = 512; // frames kept for resending; must be far larger than delay + lag
+		constexpr u32 kChunks = 64; // a memory hash "block" covers 64 frames: 1/64 of RAM is hashed each frame
+		constexpr u32 kNone = 0xFFFFFFFFu;
+		constexpr u32 kMaxFramesPerSet = 12; // keeps a host packet under ~1100 bytes with 4 players
+		constexpr u32 kMaxFramesPerIn = 30;
+		constexpr u32 kInputSize = REPORT_SIZE + 2; // report + flags + reserved
+
+		enum PacketType : u8
+		{
+			PKT_HELLO = 1,
+			PKT_WELCOME = 2,
+			PKT_REFUSE = 3,
+			PKT_START = 4,
+			PKT_STARTACK = 5,
+			PKT_IN = 6,
+			PKT_SET = 7,
+			PKT_BYE = 8,
+		};
+
+		enum InputFlags : u8
+		{
+			FLAG_ANALOG_BUTTON = 1, // the DualShock 2 "Analog" button is held
+		};
+
+		struct PadInput
+		{
+			u8 report[REPORT_SIZE];
+			u8 flags;
+			u8 reserved;
+		};
+
+		PadInput NeutralInput()
+		{
+			PadInput in{};
+			in.report[0] = 0xFF;
+			in.report[1] = 0xFF;
+			for (int i = 2; i < 6; i++)
+				in.report[i] = Pad::ANALOG_NEUTRAL_POSITION;
+			return in;
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Settings from the session INI
+		struct Config
+		{
+			bool enabled = false;
+			bool host = false;
+			std::string host_address = "127.0.0.1";
+			u16 port = 28150;
+			u32 players = 2; // host: how many players to wait for
+			std::string name = "Player";
+			u32 delay = 0; // 0 = automatic from the measured round-trip time
+			// Emulated controller of player 1..4: port 1, then a multitap in port 2 (slots 2A, 2B, 2C).
+			// Digimon Rumble Arena 2 uses this layout (docs/TESTS.md j01/j02); other games may want 0,2,3,4.
+			std::array<u8, kMaxPlayers> slots = {0, 1, 5, 6};
+			std::string bot = "none"; // none | random | script
+			std::string script;
+			std::string bot_then = "idle"; // after the script: idle | random | live
+			u32 bot_seed = 1;
+			std::string log_file;
+			std::vector<u32> snap_frames;
+			std::vector<u32> dump_frames; // test only: write the EE main memory to snap_dir at these frames
+			u32 snap_every = 0;
+			std::string snap_dir;
+			u32 exit_at_frame = 0;
+			u32 drop_after_s = 20;
+			u32 impair_loss_pct = 0;
+			u32 impair_delay_ms = 0;
+			u32 impair_jitter_ms = 0;
+			std::vector<u32> peek; // test only: log these EE words with the stats
+			bool smooth = true; // host: bigger input delay on uneven internet connections (fewer pauses)
+			u8 screen = 0; // 0 = 4:3 as the game was made, 1 = the game's widescreen 16:9 patch
+			// Own-screen view (display only): 0 = my own player's view, N = player N's view, 0xFF = whole picture.
+			u8 view = 0;
+			bool snap_view = false; // test snapshots show what this PC shows instead of the unchanged picture
+		};
+
+		Config s_cfg;
+		bool s_cfg_loaded = false;
+
+		std::vector<u32> ParseList(const std::string& v)
+		{
+			std::vector<u32> out;
+			for (const std::string_view part : StringUtil::SplitString(v, ',', true))
+			{
+				if (const std::optional<u32> n = StringUtil::FromChars<u32>(StringUtil::StripWhitespace(part)))
+					out.push_back(*n);
+			}
+			return out;
+		}
+
+		void LoadConfig()
+		{
+			if (s_cfg_loaded)
+				return;
+			s_cfg_loaded = true;
+			const char* path = std::getenv("PS2NET_CONFIG");
+			if (!path || !*path)
+				return;
+			const std::optional<std::string> text = FileSystem::ReadFileToString(path);
+			if (!text)
+			{
+				Console.Error("(PS2Net) cannot read session file %s", path);
+				return;
+			}
+			Config c;
+			c.enabled = true;
+			for (const std::string_view raw : StringUtil::SplitString(*text, '\n', true))
+			{
+				const std::string_view line = StringUtil::StripWhitespace(raw);
+				if (line.empty() || line[0] == ';' || line[0] == '#' || line[0] == '[')
+					continue;
+				const size_t eq = line.find('=');
+				if (eq == std::string_view::npos)
+					continue;
+				const std::string key = StringUtil::toLower(StringUtil::StripWhitespace(line.substr(0, eq)));
+				const std::string val(StringUtil::StripWhitespace(line.substr(eq + 1)));
+				const u32 num = StringUtil::FromChars<u32>(val).value_or(0);
+				if (key == "role")
+					c.host = StringUtil::toLower(val) == "host";
+				else if (key == "host")
+					c.host_address = val;
+				else if (key == "port")
+					c.port = static_cast<u16>(num ? num : 28150);
+				else if (key == "players")
+					c.players = std::clamp<u32>(num, 1, kMaxPlayers);
+				else if (key == "name")
+					c.name = val.substr(0, 15);
+				else if (key == "delay")
+					c.delay = std::min<u32>(num, 30);
+				else if (key == "slots")
+				{
+					const std::vector<u32> v = ParseList(val);
+					c.slots.fill(kNoSlot);
+					for (size_t i = 0; i < v.size() && i < kMaxPlayers; i++)
+						c.slots[i] = static_cast<u8>(std::min<u32>(v[i], 7));
+				}
+				else if (key == "bot")
+					c.bot = StringUtil::toLower(val);
+				else if (key == "script")
+					c.script = val;
+				else if (key == "botthen")
+					c.bot_then = StringUtil::toLower(val);
+				else if (key == "botseed")
+					c.bot_seed = num;
+				else if (key == "logfile")
+					c.log_file = val;
+				else if (key == "snapframes")
+					c.snap_frames = ParseList(val);
+				else if (key == "dumpframes")
+					c.dump_frames = ParseList(val);
+				else if (key == "snapevery")
+					c.snap_every = num;
+				else if (key == "snapdir")
+					c.snap_dir = val;
+				else if (key == "exitatframe")
+					c.exit_at_frame = num;
+				else if (key == "dropafter")
+					c.drop_after_s = num;
+				else if (key == "impairloss")
+					c.impair_loss_pct = std::min<u32>(num, 100);
+				else if (key == "impairdelay")
+					c.impair_delay_ms = num;
+				else if (key == "impairjitter")
+					c.impair_jitter_ms = num;
+				else if (key == "buffer")
+					c.smooth = StringUtil::toLower(val) != "fast";
+				else if (key == "screen")
+					c.screen = (val == "16:9") ? 1 : 0;
+				else if (key == "view")
+					c.view = (StringUtil::toLower(val) == "off") ? 0xFF : static_cast<u8>(std::min<u32>(num, kMaxPlayers));
+				else if (key == "snapview")
+					c.snap_view = (num != 0);
+				else if (key == "peek")
+				{
+					for (const std::string_view part : StringUtil::SplitString(val, ',', true))
+						if (auto n = StringUtil::FromChars<u32>(StringUtil::StripWhitespace(part), 16))
+							c.peek.push_back(*n);
+				}
+			}
+			// the layout decides the most players (for example 2 without a multitap)
+			const u32 usable = static_cast<u32>(std::count_if(c.slots.begin(), c.slots.end(), [](u8 v) { return v != kNoSlot; }));
+			c.players = std::clamp<u32>(c.players, 1, std::max<u32>(usable, 1));
+			s_cfg = c;
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Own-screen view (display only). Some games (with a patch) draw one view per player. A small settings
+		// file next to the game's patch file, <patches folder>/<SERIAL>_<CRC>.view, tells how. The emulator holds
+		// no game-specific numbers. Nothing here changes the emulated machine, so it cannot affect the sync.
+		//   LayoutAddress = 000F6F00   EE address (hex) of the game's layout byte; 0 = none (TestLayout is used)
+		//   SideValue = 1              layout value: ONE picture with one part per player (Player1.. below)
+		//   MarkerValue = 2            layout value: full-size views drawn one after the other, a LABEL register
+		//                              write (GS register 0x62) between them
+		//   AlternateValue = 3         layout value: the players' pictures on alternating video frames
+		//   Player1 = 0.5 0 1 1        side by side: left top right bottom, as fractions of the game picture
+		//   Player2 = 0 0 0.5 1
+		//   MarkerId = 56570001        marker layout: low 32 bits (hex) of the LABEL write
+		//   MarkerPlayer = 1           marker layout: the player whose picture is complete at the marker
+		//   MarkerBuffer = frame       marker layout: what is copied at the marker: frame = the frame buffer being
+		//                              drawn to (FRAME register), display = the frame buffer that is on display
+		//   MarkerHold = 8             marker layout: video frames a copy is shown without a new marker (0 = no limit)
+		//   OwnerAddress = 000F6F02    alternate layout: EE address (hex) of a byte saying whose picture the
+		//                              display registers select now (0 = player 1, 1 = player 2, other = all)
+		//   LayoutDelay = 0            video frames (0..3) by which the game writes the layout and owner bytes before
+		//                              the picture they describe is on display
+		//   TestLayout / MarkerTestDraws / MarkerTestEvery   development and tests only
+		struct ViewRect
+		{
+			float l = 0.0f, t = 0.0f, r = 1.0f, b = 1.0f;
+			bool set = false;
+		};
+		struct ViewSettings
+		{
+			bool loaded = false;
+			u32 layout_addr = 0;
+			u32 side_value = 1;
+			u32 marker_value = 2;
+			u32 alternate_value = 3;
+			u32 test_layout = 1;
+			std::array<ViewRect, kMaxPlayers> rect;
+			u32 marker_id = 0;
+			u32 marker_player = 1;
+			// Marker1Id .. Marker4Id: an own marker for each player (MarkerId + MarkerPlayer set one of them);
+			// MarkerAllId: a marker every PC with an own marker obeys too.
+			std::array<u32, kMaxPlayers> marker_ids = {};
+			u32 marker_all_id = 0;
+			// KeepSaveId / KeepRestoreId / KeepRestoreBlock: see GSPresentView::State.
+			u32 keep_save_id = 0;
+			u32 keep_restore_id = 0;
+			u32 keep_restore_bp = 0;
+			u32 marker_hold = 8;
+			bool marker_shown_buffer = false;
+			u32 marker_test_draws = 0;
+			u32 marker_test_every = 1;
+			u32 owner_addr = 0;
+			u32 layout_delay = 0;
+		};
+		ViewSettings s_view;
+		std::array<u8, 4> s_view_layout_hist{}; // the layout and owner bytes of the last video frames, newest first
+		std::array<u8, 4> s_view_owner_hist{};
+		GSPresentView::State s_view_posted;
+		u32 s_view_repost = 0;
+
+		void Log(const std::string& msg);
+
+		void LoadViewSettings()
+		{
+			s_view = ViewSettings();
+			s_view_layout_hist.fill(0);
+			s_view_owner_hist.fill(0xFF);
+			const std::string path = Path::Combine(EmuFolders::Patches,
+				fmt::format("{}_{:08X}.view", VMManager::GetDiscSerial(), VMManager::GetDiscCRC()));
+			const std::optional<std::string> text = FileSystem::ReadFileToString(path.c_str());
+			if (!text)
+				return;
+			for (const std::string_view raw : StringUtil::SplitString(*text, '\n', true))
+			{
+				std::string_view line = StringUtil::StripWhitespace(raw);
+				const size_t comment = line.find_first_of(";#");
+				if (comment != std::string_view::npos)
+					line = StringUtil::StripWhitespace(line.substr(0, comment));
+				const size_t eq = line.find('=');
+				if (line.empty() || eq == std::string_view::npos)
+					continue;
+				const std::string key = StringUtil::toLower(StringUtil::StripWhitespace(line.substr(0, eq)));
+				std::string val(StringUtil::StripWhitespace(line.substr(eq + 1)));
+				const u32 dec = StringUtil::FromChars<u32>(val).value_or(0);
+				const u32 hex = StringUtil::FromChars<u32>(val, 16).value_or(0);
+				if (key == "layoutaddress")
+					s_view.layout_addr = hex;
+				else if (key == "sidevalue" || key == "viewsvalue")
+					s_view.side_value = dec;
+				else if (key == "markervalue")
+					s_view.marker_value = dec;
+				else if (key == "alternatevalue")
+					s_view.alternate_value = dec;
+				else if (key == "testlayout")
+					s_view.test_layout = dec;
+				else if (key == "markerid")
+					s_view.marker_id = hex;
+				else if (key == "markerplayer")
+					s_view.marker_player = dec;
+				else if (key == "markerallid")
+					s_view.marker_all_id = hex;
+				else if (key == "keepsaveid")
+					s_view.keep_save_id = hex;
+				else if (key == "keeprestoreid")
+					s_view.keep_restore_id = hex;
+				else if (key == "keeprestoreblock")
+					s_view.keep_restore_bp = hex;
+				else if (key.size() == 9 && key.compare(0, 6, "marker") == 0 && key.compare(7, 2, "id") == 0 && key[6] >= '1' &&
+						 key[6] < static_cast<char>('1' + kMaxPlayers))
+					s_view.marker_ids[key[6] - '1'] = hex;
+				else if (key == "markerbuffer")
+					s_view.marker_shown_buffer = (StringUtil::toLower(val) == "display");
+				else if (key == "markerhold")
+					s_view.marker_hold = dec;
+				else if (key == "markertestevery")
+					s_view.marker_test_every = dec;
+				else if (key == "markertestdraws")
+					s_view.marker_test_draws = dec;
+				else if (key == "owneraddress")
+					s_view.owner_addr = hex;
+				else if (key == "layoutdelay")
+					s_view.layout_delay = std::min<u32>(dec, 3);
+				else if (key.size() == 7 && key.compare(0, 6, "player") == 0 && key[6] >= '1' && key[6] < static_cast<char>('1' + kMaxPlayers))
+				{
+					std::replace(val.begin(), val.end(), ',', ' ');
+					std::vector<float> f;
+					for (const std::string_view part : StringUtil::SplitString(val, ' ', true))
+						if (const std::optional<float> n = StringUtil::FromChars<float>(part))
+							f.push_back(*n);
+					if (f.size() == 4 && f[2] > f[0] && f[3] > f[1] && f[0] >= 0.0f && f[1] >= 0.0f && f[2] <= 1.0f && f[3] <= 1.0f)
+					{
+						ViewRect& v = s_view.rect[key[6] - '1'];
+						v.l = f[0];
+						v.t = f[1];
+						v.r = f[2];
+						v.b = f[3];
+						v.set = true;
+					}
+				}
+			}
+			// MarkerId + MarkerPlayer is the short form for one player's marker.
+			if (s_view.marker_id != 0 && s_view.marker_player >= 1 && s_view.marker_player <= kMaxPlayers &&
+				s_view.marker_ids[s_view.marker_player - 1] == 0)
+				s_view.marker_ids[s_view.marker_player - 1] = s_view.marker_id;
+			s_view.loaded = true;
+			std::string parts;
+			for (u32 i = 0; i < kMaxPlayers; i++)
+				if (s_view.marker_ids[i])
+					parts += fmt::format(" marker of player {} = {:08X};", i + 1, s_view.marker_ids[i]);
+			if (s_view.marker_all_id)
+				parts += fmt::format(" marker for everybody = {:08X};", s_view.marker_all_id);
+			if (s_view.keep_save_id && s_view.keep_restore_id)
+				parts += fmt::format(" keep a picture at {:08X}, put it back at {:08X} into block {:05X};", s_view.keep_save_id,
+					s_view.keep_restore_id, s_view.keep_restore_bp);
+			for (u32 i = 0; i < kMaxPlayers; i++)
+				if (s_view.rect[i].set)
+					parts += fmt::format(" player {} = {} {} {} {};", i + 1, s_view.rect[i].l, s_view.rect[i].t, s_view.rect[i].r, s_view.rect[i].b);
+			if (s_view.layout_delay)
+				parts += fmt::format(" the bytes are {} video frame(s) ahead of the picture;", s_view.layout_delay);
+			Log(fmt::format("view: settings file {} (layout byte at {:08X}; side by side = {}, marker = {} with id {:08X} for player {}, "
+							"alternate = {} with owner byte at {:08X});{}",
+				Path::GetFileName(path), s_view.layout_addr, s_view.side_value, s_view.marker_value, s_view.marker_id,
+				s_view.marker_player, s_view.alternate_value, s_view.owner_addr, parts));
+		}
+
+		bool SameView(const GSPresentView::State& a, const GSPresentView::State& b)
+		{
+			return a.kind == b.kind && a.left == b.left && a.top == b.top && a.right == b.right && a.bottom == b.bottom &&
+				   a.show_copy == b.show_copy && a.marker_id == b.marker_id && a.marker_all_id == b.marker_all_id &&
+				   a.keep_save_id == b.keep_save_id && a.keep_restore_id == b.keep_restore_id &&
+				   a.keep_restore_bp == b.keep_restore_bp &&
+				   a.fake_after_draws == b.fake_after_draws &&
+				   a.marker_hold == b.marker_hold && a.marker_shown_buffer == b.marker_shown_buffer && a.fake_every == b.fake_every &&
+				   a.mine == b.mine && a.in_screenshots == b.in_screenshots;
+		}
+
+		void PostView(const GSPresentView::State& want, u32 frame, u32 who)
+		{
+			// Posted when something changes, and again now and then so a restarted GS thread gets it too.
+			const bool same = SameView(want, s_view_posted);
+			if (same && (want.kind == 0 || ++s_view_repost < 120))
+				return;
+			s_view_repost = 0;
+			if (want.kind != s_view_posted.kind || want.show_copy != s_view_posted.show_copy)
+			{
+				static constexpr const char* names[] = {"whole picture", "this player's part of the picture",
+					"full-size views with a marker", "alternate video frames"};
+				std::string what = names[want.kind & 3];
+				if (want.kind == 1 || want.kind == 3)
+					what += fmt::format(", player {}", who + 1);
+				if (want.kind == 2)
+					what += want.show_copy ? ", this PC shows the copy taken at the marker" : ", this PC shows the final picture";
+				if (want.kind != 0)
+				{
+					const u64 smode2 = *reinterpret_cast<const u64*>(PS2GS_BASE(0x12000020));
+					what += fmt::format(" (video mode: interlaced {}, frame mode {})", smode2 & 1, (smode2 >> 1) & 1);
+				}
+				Log(fmt::format("view: {} from frame {}", what, frame));
+			}
+			s_view_posted = want;
+			if (MTGS::IsOpen())
+				MTGS::RunOnGSThread([want]() { GSPresentView::Apply(want); });
+		}
+
