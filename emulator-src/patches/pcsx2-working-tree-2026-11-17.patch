+		void Log(const std::string& msg)
+		{
+			Console.WriteLn("(PS2Net) %s", msg.c_str());
+			if (!s_log && !s_cfg.log_file.empty())
+				s_log = FileSystem::OpenCFile(s_cfg.log_file.c_str(), "ab");
+			if (s_log)
+			{
