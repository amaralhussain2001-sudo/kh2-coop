+
+		// ------------------------------------------------------------------------------------------------------
+		// Hashing
+		u64 Mix(u64 h, u64 v)
+		{
+			h ^= v * 0x9E3779B97F4A7C15ull;
+			h = (h << 31) | (h >> 33);
+			return h * 0xBF58476D1CE4E5B9ull;
+		}
+
+		u64 HashBytes(u64 h, const void* data, size_t size)
+		{
+			const u8* p = static_cast<const u8*>(data);
+			size_t i = 0;
+			for (; i + 8 <= size; i += 8)
+			{
+				u64 v;
+				std::memcpy(&v, p + i, 8);
+				h = Mix(h, v);
+			}
+			for (; i < size; i++)
+				h = Mix(h, p[i]);
+			return Mix(h, size);
+		}
+
+		u64 HashString(u64 h, std::string_view s) { return HashBytes(h, s.data(), s.size()); }
+
+		// Settings that change what the emulated PS2 computes. Display-only settings (resolution, filtering,
+		// window, audio output) may differ per PC. HYPOTHESIS: this list is complete enough; the memory hashes
+		// during play are the real proof.
+		u64 SettingsFingerprint(const Pcsx2Config& cfg, std::string* listing)
+		{
+			Pcsx2Config copy = cfg;
+			MemorySettingsInterface msi;
+			SettingsSaveWrapper wrap(msi);
+			copy.LoadSave(wrap);
+			static constexpr const char* kSections[] = {
+				"EmuCore/CPU", "EmuCore/CPU/Recompiler", "EmuCore/Speedhacks", "EmuCore/Gamefixes", "Pad"};
+			static constexpr const char* kCoreKeys[] = {"EnablePatches", "EnableCheats", "EnableWideScreenPatches",
+				"EnableNoInterlacingPatches", "EnableFastBoot", "EnableGameFixes", "HostFs", "CdvdPrecache",
+				"ManuallySetRealTimeClock", "RtcYear", "RtcMonth", "RtcDay", "RtcHour", "RtcMinute", "RtcSecond"};
+			static constexpr const char* kGsKeys[] = {"Renderer", "HWDownloadMode"};
+			u64 h = 0x5053324E6574ull;
+			auto add = [&](const char* sec, const std::string& k, const std::string& v) {
+				h = HashString(h, fmt::format("{}/{}={}\n", sec, k, v));
+				if (listing)
+					*listing += fmt::format("  {}/{} = {}\n", sec, k, v);
+			};
+			for (const char* sec : kSections)
+			{
+				auto kv = msi.GetKeyValueList(sec);
+				std::sort(kv.begin(), kv.end());
+				for (const auto& [k, v] : kv)
+					add(sec, k, v);
+			}
+			for (const char* k : kCoreKeys)
+				if (msi.ContainsValue("EmuCore", k))
+					add("EmuCore", k, msi.GetStringValue("EmuCore", k));
+			for (const char* k : kGsKeys)
+				if (msi.ContainsValue("EmuCore/GS", k))
+					add("EmuCore/GS", k, msi.GetStringValue("EmuCore/GS", k));
+			add("PS2Net", "Screen", std::to_string(s_cfg.screen));
+			for (u32 i = 0; i < Pad::NUM_CONTROLLER_PORTS; i++)
+				add("PadType", std::to_string(i), std::to_string(static_cast<int>(cfg.Pad.Ports[i].Type)));
+			return h;
+		}
+
+		const char* ScreenName(u8 screen)
+		{
+			return screen == 1 ? "widescreen 16:9" : "normal 4:3";
+		}
+
+		std::string LayoutName(const std::array<u8, kMaxPlayers>& slots)
+		{
+			std::string s;
+			for (u8 v : slots)
+				if (v != kNoSlot)
+					s += (s.empty() ? "" : ",") + std::to_string(v);
+			if (s == "0,1")
+				return "2 players, no multitap";
+			if (s == "0,2,3,4")
+				return "multitap in port 1";
+			if (s == "0,1,5,6")
+				return "multitap in port 2";
+			return "slots " + s;
+		}
+
+		// Patch files change game memory (for example the Digimon unlock), so every PC must have the same ones.
+		u64 PatchFilesHash()
+		{
+			u64 h = 0x5041544348ull;
+			FileSystem::FindResultsArray files;
+			FileSystem::FindFiles(EmuFolders::Patches.c_str(), "*.pnach", FILESYSTEM_FIND_FILES | FILESYSTEM_FIND_SORT_BY_NAME, &files);
+			for (const FILESYSTEM_FIND_DATA& f : files)
+			{
+				h = HashString(h, Path::GetFileName(f.FileName));
+				if (const std::optional<std::vector<u8>> data = FileSystem::ReadBinaryFile(f.FileName.c_str()))
+					h = HashBytes(h, data->data(), data->size());
+			}
+			return h;
+		}
+
+		u64 MemcardHash()
+		{
+			u64 h = 0x4D4344ull;
+			for (int i = 0; i < 2; i++)
+			{
+				const Pcsx2Config::McdOptions& m = EmuConfig.Mcd[i];
+				h = Mix(h, m.Enabled ? 1 : 0);
+				if (!m.Enabled)
+					continue;
+				const std::string path = Path::Combine(EmuFolders::MemoryCards, m.Filename);
+				if (const std::optional<std::vector<u8>> data = FileSystem::ReadBinaryFile(path.c_str()))
+					h = HashBytes(h, data->data(), data->size());
+				else
+					h = Mix(h, 0xDEAD); // folder card or missing file
+			}
+			return h;
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Byte buffers for packets (little endian)
+		struct Writer
+		{
+			std::vector<u8> b;
+			void u8_(u8 v) { b.push_back(v); }
+			void u16_(u16 v) { u8_(v & 0xFF); u8_(v >> 8); }
+			void u32_(u32 v) { u16_(v & 0xFFFF); u16_(v >> 16); }
+			void u64_(u64 v) { u32_(static_cast<u32>(v)); u32_(static_cast<u32>(v >> 32)); }
+			void bytes(const void* p, size_t n) { b.insert(b.end(), static_cast<const u8*>(p), static_cast<const u8*>(p) + n); }
+			void str(const std::string& s, size_t n)
+			{
+				for (size_t i = 0; i < n; i++)
+					u8_(i < s.size() ? static_cast<u8>(s[i]) : 0);
+			}
+		};
+
+		struct Reader
+		{
+			const u8* p;
+			size_t n;
+			size_t i = 0;
+			bool ok = true;
+			bool need(size_t k)
+			{
+				if (i + k > n)
+					ok = false;
+				return ok;
+			}
+			u8 u8_() { return need(1) ? p[i++] : 0; }
+			u16 u16_() { const u16 lo = u8_(); return static_cast<u16>(lo | (u8_() << 8)); }
+			u32 u32_() { const u32 lo = u16_(); return lo | (static_cast<u32>(u16_()) << 16); }
+			u64 u64_() { const u64 lo = u32_(); return lo | (static_cast<u64>(u32_()) << 32); }
+			void bytes(void* out, size_t k)
+			{
+				if (need(k))
+				{
+					std::memcpy(out, p + i, k);
+					i += k;
+				}
+			}
+			std::string str(size_t k)
+			{
+				std::string s;
+				for (size_t j = 0; j < k; j++)
+				{
+					const char c = static_cast<char>(u8_());
+					if (c)
+						s.push_back(c);
+				}
+				return s;
+			}
+		};
+
+		// ------------------------------------------------------------------------------------------------------
+		// Session state
+		struct Addr
+		{
+			sockaddr_storage sa{};
+			int len = 0;
+			bool operator==(const Addr& o) const { return len == o.len && std::memcmp(&sa, &o.sa, len) == 0; }
+			std::string ToString() const
+			{
+				char host[NI_MAXHOST] = {}, serv[NI_MAXSERV] = {};
+				getnameinfo(reinterpret_cast<const sockaddr*>(&sa), len, host, sizeof(host), serv, sizeof(serv),
+					NI_NUMERICHOST | NI_NUMERICSERV);
+				return fmt::format("{}:{}", host, serv);
+			}
+		};
+
+		struct FrameSlot
+		{
+			u32 frame = kNone;
+			std::array<bool, kMaxPlayers> have = {};
+			std::array<PadInput, kMaxPlayers> in = {};
+			u8 dropped = 0; // bit p: player p is gone, neutral input
+			bool complete = false; // client: the host sent this frame
+		};
+
+		struct Peer // host side: one connected client
+		{
+			Addr addr;
+			u32 nonce = 0;
+			std::string name;
+			bool started = false; // sent STARTACK or inputs
+			u32 ack_set = 0; // next frame the client still needs from us
+			u32 next_in = 0; // next frame we still need from the client
+			double last_rx_ms = 0;
+			u32 hellos = 0;
+			u32 rtt_ms = 0;
+			std::vector<u32> rtts; // round trips measured in the lobby (ms)
+			std::deque<std::pair<u32, u64>> reports; // (block, digest) not yet compared
+			bool dropped = false;
+			u32 last_report_block = kNone;
+		};
+
+		struct Delayed
+		{
+			double due_ms;
+			Addr to;
+			std::vector<u8> data;
+		};
+
+		struct Session
+		{
+			Config cfg;
+			SOCKET sock = INVALID_SOCKET;
+			Addr host_addr; // client: where the host is
+			u32 session_id = 0;
+			u32 nonce = 0;
+			u32 me = 0; // my player index (0 = host)
+			u32 players = 1;
+			u32 delay = 2;
+			std::array<u8, kMaxPlayers> slots = {0, 1, 5, 6};
+			std::array<std::string, kMaxPlayers> names;
+			bool started = false;
+			bool ended = false;
+			bool exit_requested = false;
+			u32 frame = 0; // session frame about to be emulated
+			std::vector<FrameSlot> ring = std::vector<FrameSlot>(kRing);
+			std::array<PadInput, kMaxPlayers> cur; // inputs of the current frame (what the controllers report)
+			std::array<u8, kMaxPlayers> prev_flags = {};
+			std::array<u32, kMaxPlayers> dropped_from = {kNone, kNone, kNone, kNone};
+			std::vector<Peer> peers; // host only; peers[k] = player k+1
+			u32 client_next_set = 0; // client: next frame not yet received from the host
+			u32 host_ack_in = 0; // client: next frame of ours the host still needs
+			double last_send_ms = 0;
+			double last_rx_ms = 0;
+			u32 rtt_ms = 0;
+			std::vector<u32> rtts; // client: round trips to the host measured in the lobby
+			double start_at = 0; // both sides: local time (ms) at which frame 0 begins
+			bool start_pending = false; // client: START received, waiting for start_at
+			bool forward = false; // host: new inputs arrived, pass them on at once
+			// hashing
+			u64 block_hash = 0;
+			std::array<u64, kChunks> chunk_hash = {};
+			std::deque<std::pair<u32, u64>> my_digests; // (block, digest), newest last
+			std::deque<std::pair<u32, std::array<u64, kChunks>>> my_chunks;
+			u32 report_block = kNone;
+			u64 report_digest = 0;
+			u32 desync_block = kNone;
+			u32 desync_player = 0;
+			bool desync_logged = false;
+			u64 compared = 0;
+			// statistics
+			u64 waits = 0;
+			double wait_total_ms = 0, wait_max_ms = 0;
+			double last_stats_ms = 0;
+			// bots
+			std::vector<std::pair<std::pair<u32, u32>, PadInput>> script; // ((from, to), input)
+			u32 script_end = 0;
+			// impairment
+			std::mt19937 rng{12345};
+			std::vector<Delayed> delayed;
+			u64 fingerprint = 0;
+			std::string fingerprint_listing;
+			u64 mcd_hash = 0;
+			u64 patch_hash = 0;
+		};
+
+		std::unique_ptr<Session> s_session;
+
+		// Diagnostics: how often the game polled each emulated controller slot (reply bytes), and with START held.
+		std::array<u64, 8> s_poll_bytes = {};
+		std::array<u64, 8> s_poll_start = {};
+
+		FrameSlot& Slot(u32 frame)
+		{
+			FrameSlot& fs = s_session->ring[frame % kRing];
+			if (fs.frame != frame)
+			{
+				fs = FrameSlot();
+				fs.frame = frame;
+			}
+			return fs;
+		}
+
+		const FrameSlot* PeekSlot(u32 frame)
+		{
+			const FrameSlot& fs = s_session->ring[frame % kRing];
+			return fs.frame == frame ? &fs : nullptr;
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Socket
+		bool s_wsa = false;
+
+		void RawSend(Session& s, const Addr& to, const std::vector<u8>& data)
+		{
+			sendto(s.sock, reinterpret_cast<const char*>(data.data()), static_cast<int>(data.size()), 0,
+				reinterpret_cast<const sockaddr*>(&to.sa), to.len);
+		}
+
+		void SendTo(Session& s, const Addr& to, const Writer& w)
+		{
+			if (s.cfg.impair_loss_pct && (s.rng() % 100) < s.cfg.impair_loss_pct)
+				return;
+			if (s.cfg.impair_delay_ms || s.cfg.impair_jitter_ms)
+			{
+				const double extra = s.cfg.impair_jitter_ms ? static_cast<double>(s.rng() % (s.cfg.impair_jitter_ms + 1)) : 0.0;
+				s.delayed.push_back({NowMs() + s.cfg.impair_delay_ms + extra, to, w.b});
+				return;
+			}
+			RawSend(s, to, w.b);
+		}
+
+		void FlushDelayed(Session& s)
+		{
+			const double now = NowMs();
+			for (size_t i = 0; i < s.delayed.size();)
+			{
+				if (s.delayed[i].due_ms <= now)
+				{
+					RawSend(s, s.delayed[i].to, s.delayed[i].data);
+					s.delayed.erase(s.delayed.begin() + i);
+				}
+				else
+					i++;
+			}
+		}
+
+		Writer Header(const Session& s, PacketType t)
+		{
+			Writer w;
+			w.u32_(kMagic);
+			w.u8_(t);
+			w.u32_(s.session_id);
+			return w;
+		}
+
+		bool OpenSocket(Session& s, std::string* error)
+		{
+			if (!s_wsa)
+			{
+				WSADATA wd;
+				if (WSAStartup(MAKEWORD(2, 2), &wd) != 0)
+				{
+					*error = "WSAStartup failed";
+					return false;
+				}
+				s_wsa = true;
+			}
+			int family = AF_INET6;
+			if (!s.cfg.host)
+			{
+				addrinfo hints{};
+				hints.ai_family = AF_UNSPEC;
+				hints.ai_socktype = SOCK_DGRAM;
+				addrinfo* res = nullptr;
+				const std::string port = std::to_string(s.cfg.port);
+				if (getaddrinfo(s.cfg.host_address.c_str(), port.c_str(), &hints, &res) != 0 || !res)
+				{
+					*error = fmt::format("cannot find the host address '{}'", s.cfg.host_address);
+					return false;
+				}
+				std::memcpy(&s.host_addr.sa, res->ai_addr, res->ai_addrlen);
+				s.host_addr.len = static_cast<int>(res->ai_addrlen);
+				family = res->ai_family;
+				freeaddrinfo(res);
+			}
+			s.sock = socket(family, SOCK_DGRAM, IPPROTO_UDP);
+			if (s.sock == INVALID_SOCKET)
+			{
+				*error = "cannot create a UDP socket";
+				return false;
+			}
+			u_long nb = 1;
+			ioctlsocket(s.sock, FIONBIO, &nb);
+			int buf = 1 << 20;
+			setsockopt(s.sock, SOL_SOCKET, SO_RCVBUF, reinterpret_cast<const char*>(&buf), sizeof(buf));
+			// Windows reports ICMP "port unreachable" as WSAECONNRESET on the next recvfrom; switch that off.
+			BOOL off = FALSE;
+			DWORD ret = 0;
+			WSAIoctl(s.sock, _WSAIOW(IOC_VENDOR, 12), &off, sizeof(off), nullptr, 0, &ret, nullptr, nullptr);
+			if (s.cfg.host)
+			{
+				DWORD v6only = 0; // accept IPv4 and IPv6 players on one socket
+				setsockopt(s.sock, IPPROTO_IPV6, IPV6_V6ONLY, reinterpret_cast<const char*>(&v6only), sizeof(v6only));
+				sockaddr_in6 a{};
+				a.sin6_family = AF_INET6;
+				a.sin6_addr = in6addr_any;
+				a.sin6_port = htons(s.cfg.port);
+				if (bind(s.sock, reinterpret_cast<const sockaddr*>(&a), sizeof(a)) != 0)
+				{
+					*error = fmt::format("cannot use UDP port {} (is another copy already hosting?)", s.cfg.port);
+					return false;
+				}
+			}
+			return true;
+		}
+
+		void WaitForPacket(Session& s, int timeout_ms)
+		{
+			fd_set set;
+			FD_ZERO(&set);
+			FD_SET(s.sock, &set);
+			timeval tv{0, timeout_ms * 1000};
+			select(0, &set, nullptr, nullptr, &tv);
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Packets
+		void WriteInput(Writer& w, const PadInput& in) { w.bytes(&in, kInputSize); }
+		PadInput ReadInput(Reader& r)
+		{
+			PadInput in;
+			r.bytes(&in, kInputSize);
+			return in;
+		}
+
+		void SendHello(Session& s)
+		{
+			Writer w = Header(s, PKT_HELLO);
+			w.u32_(kProtocol);
+			w.u32_(s.nonce);
+			w.u64_(s.fingerprint);
+			w.u32_(VMManager::GetDiscCRC());
+			w.u32_(BiosChecksum);
+			w.str(VMManager::GetDiscSerial(), 16);
+			w.str(s.cfg.name, 16);
+			w.u64_(s.mcd_hash);
+			for (u32 p = 0; p < kMaxPlayers; p++)
+				w.u8_(s.cfg.slots[p]);
+			w.u64_(s.patch_hash);
+			w.u8_(s.cfg.screen);
+			w.u16_(static_cast<u16>(std::min<u32>(s.rtt_ms, 65535)));
+			w.u64_(static_cast<u64>(NowMs()));
+			SendTo(s, s.host_addr, w);
+		}
+
+		void SendRefuse(Session& s, const Addr& to, u32 nonce, const std::string& why)
+		{
+			Writer w = Header(s, PKT_REFUSE);
+			w.u32_(nonce);
+			w.str(why, 120);
+			SendTo(s, to, w);
+		}
+
+		void SendStart(Session& s, const Addr& to)
+		{
+			Writer w = Header(s, PKT_START);
+			w.u8_(static_cast<u8>(s.players));
+			w.u8_(static_cast<u8>(s.delay));
+			for (u32 p = 0; p < kMaxPlayers; p++)
+				w.u8_(s.slots[p]);
+			for (u32 p = 0; p < kMaxPlayers; p++)
+				w.str(s.names[p], 16);
+			w.u32_(static_cast<u32>(std::max(0.0, s.start_at - NowMs()))); // ms until frame 0 on the host
+			SendTo(s, to, w);
+		}
+
+		// client -> host: our inputs the host has not confirmed yet, plus our latest memory digest
+		void SendInputs(Session& s)
+		{
+			Writer w = Header(s, PKT_IN);
+			w.u32_(s.client_next_set);
+			const u32 newest = s.frame + s.delay; // we know our input up to here
+			u32 first = std::max(s.host_ack_in, s.delay);
+			if (newest + 1 > first + kMaxFramesPerIn)
+				first = newest + 1 - kMaxFramesPerIn;
+			const u32 count = newest >= first ? newest - first + 1 : 0;
+			w.u32_(first);
+			w.u8_(static_cast<u8>(count));
+			for (u32 f = first; f < first + count; f++)
+			{
+				const FrameSlot* fs = PeekSlot(f);
+				WriteInput(w, fs ? fs->in[s.me] : NeutralInput());
+			}
+			w.u32_(s.report_block);
+			w.u64_(s.report_digest);
+			w.u64_(static_cast<u64>(NowMs()));
+			SendTo(s, s.host_addr, w);
+			s.last_send_ms = NowMs();
+		}
+
+		bool AllInputsKnown(Session& s, u32 f)
+		{
+			if (f < s.delay)
+				return true;
+			const FrameSlot* fs = PeekSlot(f);
+			if (!fs)
+				return false;
+			for (u32 p = 0; p < s.players; p++)
+				if (!fs->have[p] && !(fs->dropped & (1u << p)))
+					return false;
+			return true;
+		}
+
+		void AdvanceClientAck(Session& s)
+		{
+			while (AllInputsKnown(s, s.client_next_set) && s.client_next_set < s.frame + kRing / 2)
+				s.client_next_set++;
+		}
+
+		bool HostFrameComplete(Session& s, u32 f)
+		{
+			if (f < s.delay)
+				return true;
+			const FrameSlot* fs = PeekSlot(f);
+			if (!fs)
+				return false;
+			for (u32 p = 0; p < s.players; p++)
+				if (!fs->have[p] && !(fs->dropped & (1u << p)))
+					return false;
+			return true;
+		}
+
+		// host -> each client: every other player's input the host knows for the frames the client still needs.
+		// Protocol 4: a frame does not have to be complete; each input travels on as soon as the host has it, so an
+		// input needs one way (player -> host -> other player) instead of a round trip. Needs proper testing.
+		void SendSets(Session& s)
+		{
+			const u32 per_frame = 2 + kInputSize * (s.players > 1 ? s.players - 1 : 1);
+			const u32 max_frames = std::clamp<u32>(1100 / per_frame, 4, 30);
+			for (u32 k = 0; k < s.peers.size(); k++)
+			{
+				Peer& peer = s.peers[k];
+				if (peer.dropped)
+					continue;
+				const u32 player = k + 1;
+				Writer w = Header(s, PKT_SET);
+				w.u32_(peer.next_in);
+				const u32 first = std::max(peer.ack_set, s.delay);
+				u32 count = 0;
+				while (count < max_frames && PeekSlot(first + count))
+					count++;
+				w.u32_(first);
+				w.u8_(static_cast<u8>(count));
+				w.u8_(static_cast<u8>(s.players));
+				for (u32 f = first; f < first + count; f++)
+				{
+					const FrameSlot* fs = PeekSlot(f);
+					u8 mask = 0;
+					for (u32 p = 0; p < s.players; p++)
+						if (p != player && fs->have[p] && !(fs->dropped & (1u << p)))
+							mask |= static_cast<u8>(1u << p);
+					w.u8_(mask);
+					w.u8_(fs->dropped);
+					for (u32 p = 0; p < s.players; p++)
+						if (mask & (1u << p))
+							WriteInput(w, fs->in[p]);
+				}
+				w.u32_(s.desync_block);
+				w.u8_(static_cast<u8>(s.desync_player));
+				w.u64_(static_cast<u64>(NowMs()));
+				SendTo(s, peer.addr, w);
+			}
+			s.last_send_ms = NowMs();
+		}
+
+		void NoteDesync(Session& s, u32 block, u32 player)
+		{
+			if (s.desync_block != kNone)
+				return;
+			s.desync_block = block;
+			s.desync_player = player;
+		}
+
+		void CompareReports(Session& s)
+		{
+			for (u32 k = 0; k < s.peers.size(); k++)
+			{
+				Peer& peer = s.peers[k];
+				if (peer.dropped)
+				{
+					peer.reports.clear();
+					continue;
+				}
+				while (!peer.reports.empty())
+				{
+					const auto [block, digest] = peer.reports.front();
+					auto it = std::find_if(s.my_digests.begin(), s.my_digests.end(), [b = block](const auto& e) { return e.first == b; });
+					if (it == s.my_digests.end())
+					{
+						if (!s.my_digests.empty() && block < s.my_digests.front().first)
+							peer.reports.pop_front(); // too old to compare
+						else
+							break; // we have not reached that block yet
+						continue;
+					}
+					s.compared++;
+					if (it->second != digest)
+					{
+						Log(fmt::format("OUT OF SYNC: player {} memory digest for block {} (frames {}-{}) is {:016x}, host has {:016x}",
+							k + 2, block, block * kChunks, block * kChunks + kChunks - 1, digest, it->second));
+						NoteDesync(s, block, k + 1);
+					}
+					peer.reports.pop_front();
+				}
+			}
+		}
+
+		void HandleHello(Session& s, const Addr& from, Reader& r)
+		{
+			const u32 proto = r.u32_();
+			const u32 nonce = r.u32_();
+			const u64 fp = r.u64_();
+			const u32 crc = r.u32_();
+			const u32 bios = r.u32_();
+			const std::string serial = r.str(16);
+			const std::string name = r.str(16);
+			const u64 mcd = r.u64_();
+			std::array<u8, kMaxPlayers> slots;
+			for (u32 p = 0; p < kMaxPlayers; p++)
+				slots[p] = r.u8_();
+			const u64 patches = r.u64_();
+			const u8 screen = r.u8_();
+			const u32 rtt = r.u16_();
+			const u64 t = r.u64_();
+			if (!r.ok)
+				return;
+			auto it = std::find_if(s.peers.begin(), s.peers.end(), [&](const Peer& p) { return p.nonce == nonce; });
+			if (it == s.peers.end())
+			{
+				std::string why;
+				if (proto != kProtocol)
+					why = "Different version of the online emulator. Everyone needs the same package.";
+				else if (s.started)
+					why = "The game has already started. Joining later is not possible yet.";
+				else if (s.peers.size() + 1 >= s.players)
+					why = "The game is full.";
+				else if (slots != s.slots)
+					why = fmt::format("Different controller layout: you chose '{}', the host uses '{}'. Choose the same layout.",
+						LayoutName(slots), LayoutName(s.slots));
+				else if (screen != s.cfg.screen)
+					why = fmt::format("Different screen: you chose '{}', the host uses '{}'. Choose the same screen.",
+						ScreenName(screen), ScreenName(s.cfg.screen));
+				else if (crc != VMManager::GetDiscCRC() || serial != VMManager::GetDiscSerial())
+					why = fmt::format("Different game disc ({} {:08X}); the host has {} {:08X}.", serial, crc,
+						VMManager::GetDiscSerial(), VMManager::GetDiscCRC());
+				else if (bios != BiosChecksum)
+					why = "Different PS2 BIOS. Everyone needs the same BIOS file.";
+				else if (patches != s.patch_hash)
+					why = "Different patch files in the emulator's patches folder (for example the character unlock). Everyone needs the same package.";
+				else if (fp != s.fingerprint)
+					why = "Different emulator settings (speed hacks, game fixes or renderer). Use the package settings.";
+				else if (mcd != s.mcd_hash)
+					why = "Different memory card. For now everyone needs the same memory card file.";
+				if (!why.empty())
+				{
+					Log(fmt::format("refused {} '{}': {}", from.ToString(), name, why));
+					SendRefuse(s, from, nonce, why);
+					return;
+				}
+				Peer p;
+				p.addr = from;
+				p.nonce = nonce;
+				p.name = name;
+				s.peers.push_back(p);
+				it = s.peers.end() - 1;
+				const u32 idx = static_cast<u32>(s.peers.size());
+				s.names[idx] = name;
+				Log(fmt::format("player {} '{}' joined from {}", idx + 1, name, from.ToString()));
+				Osd("ps2net_join", fmt::format("{} joined as player {}", name, idx + 1), 5.0f);
+			}
+			it->addr = from; // the player's address may change (NAT rebinding)
+			it->last_rx_ms = NowMs();
+			it->hellos++;
+			it->rtt_ms = rtt;
+			if (rtt > 0 && it->rtts.size() < 64)
+				it->rtts.push_back(rtt);
+			Writer w = Header(s, PKT_WELCOME);
+			w.u32_(nonce);
+			w.u8_(static_cast<u8>(it - s.peers.begin() + 1));
+			w.u8_(static_cast<u8>(s.players));
+			w.u8_(static_cast<u8>(s.peers.size() + 1));
+			w.u64_(t);
+			SendTo(s, from, w);
+		}
+
+		void HandleIn(Session& s, const Addr& from, Reader& r)
+		{
+			auto it = std::find_if(s.peers.begin(), s.peers.end(), [&](const Peer& p) { return p.addr == from; });
+			if (it == s.peers.end() || it->dropped)
+				return;
+			const u32 player = static_cast<u32>(it - s.peers.begin()) + 1;
+			const u32 ack_set = r.u32_();
+			const u32 first = r.u32_();
+			const u32 count = r.u8_();
+			std::vector<PadInput> ins;
+			for (u32 i = 0; i < count; i++)
+				ins.push_back(ReadInput(r));
+			const u32 block = r.u32_();
+			const u64 digest = r.u64_();
+			r.u64_();
+			if (!r.ok)
+				return;
+			it->started = true;
+			it->last_rx_ms = NowMs();
+			it->ack_set = std::max(it->ack_set, ack_set);
+			for (u32 i = 0; i < count; i++)
+			{
+				const u32 f = first + i;
+				if (f < s.frame || f >= s.frame + kRing / 2 || f >= s.dropped_from[player])
+					continue; // already applied, too far ahead, or the player was dropped
+				FrameSlot& fs = Slot(f);
+				if (!fs.have[player])
+				{
+					fs.have[player] = true;
+					fs.in[player] = ins[i];
+					s.forward = true;
+				}
+			}
+			while (true)
+			{
+				const FrameSlot* fs = PeekSlot(it->next_in);
+				if (it->next_in < s.delay || (fs && fs->have[player]))
+					it->next_in++;
+				else
+					break;
+			}
+			if (block != kNone && (it->last_report_block == kNone || block > it->last_report_block))
+			{
+				it->last_report_block = block;
+				it->reports.push_back({block, digest});
+			}
+		}
+
+		void HandleSet(Session& s, Reader& r)
+		{
+			const u32 ack_in = r.u32_();
+			const u32 first = r.u32_();
+			const u32 count = r.u8_();
+			const u32 players = r.u8_();
+			if (!r.ok || players != s.players)
+				return;
+			for (u32 i = 0; i < count; i++)
+			{
+				const u32 f = first + i;
+				const u8 mask = r.u8_();
+				const u8 dropped = r.u8_();
+				std::array<PadInput, kMaxPlayers> ins;
+				for (u32 p = 0; p < players; p++)
+					if (mask & (1u << p))
+						ins[p] = ReadInput(r);
+				if (!r.ok)
+					return;
+				if (f < s.frame || f >= s.frame + kRing / 2)
+					continue;
+				FrameSlot& fs = Slot(f);
+				fs.dropped |= dropped;
+				for (u32 p = 0; p < players; p++)
+				{
+					if (p == s.me || !(mask & (1u << p)) || fs.have[p])
+						continue;
+					fs.have[p] = true;
+					fs.in[p] = ins[p];
+				}
+			}
+			const u32 desync_block = r.u32_();
+			const u32 desync_player = r.u8_();
+			r.u64_();
+			if (!r.ok)
+				return;
+			s.host_ack_in = std::max(s.host_ack_in, ack_in);
+			AdvanceClientAck(s);
+			if (desync_block != kNone && s.desync_block == kNone)
+			{
+				s.desync_block = desync_block;
+				s.desync_player = desync_player;
+			}
+		}
+
+		void Receive(Session& s)
+		{
+			FlushDelayed(s);
+			u8 buf[2048];
+			while (true)
+			{
+				Addr from;
+				from.len = sizeof(from.sa);
+				const int n = recvfrom(s.sock, reinterpret_cast<char*>(buf), sizeof(buf), 0, reinterpret_cast<sockaddr*>(&from.sa), &from.len);
+				if (n <= 0)
+					break;
+				Reader r{buf, static_cast<size_t>(n)};
+				if (r.u32_() != kMagic)
+					continue;
+				const u8 type = r.u8_();
+				const u32 sid = r.u32_();
+				if (!r.ok)
+					continue;
+				if (s.cfg.host)
+				{
+					if (type == PKT_HELLO)
+						HandleHello(s, from, r);
+					else if (sid != s.session_id)
+						continue;
+					else if (type == PKT_STARTACK || type == PKT_IN)
+					{
+						auto it = std::find_if(s.peers.begin(), s.peers.end(), [&](const Peer& p) { return p.addr == from; });
+						if (it != s.peers.end())
+						{
+							it->started = true;
+							it->last_rx_ms = NowMs();
+						}
+						if (type == PKT_IN)
+							HandleIn(s, from, r);
+					}
+					else if (type == PKT_BYE)
+					{
+						auto it = std::find_if(s.peers.begin(), s.peers.end(), [&](const Peer& p) { return p.addr == from; });
+						if (it != s.peers.end())
+						{
+							Log(fmt::format("player {} said goodbye", it - s.peers.begin() + 2));
+							it->last_rx_ms = 0; // dropped by the timeout logic at once
+						}
+					}
+				}
+				else
+				{
+					if (!(from == s.host_addr))
+						continue;
+					s.last_rx_ms = NowMs();
+					if (type == PKT_WELCOME)
+					{
+						if (r.u32_() != s.nonce)
+							continue;
+						s.session_id = sid;
+						s.me = r.u8_();
+						const u32 needed = r.u8_();
+						const u32 connected = r.u8_();
+						const u64 t = r.u64_();
+						if (!r.ok)
+							continue;
+						s.rtt_ms = static_cast<u32>(std::max(0.0, NowMs() - static_cast<double>(t)));
+						if (s.rtts.size() < 64)
+							s.rtts.push_back(s.rtt_ms);
+						Osd("ps2net_lobby", fmt::format("Connected to the host as player {}. Players: {} of {}. Waiting...", s.me + 1,
+							connected, needed), 2.0f);
+					}
+					else if (type == PKT_REFUSE)
+					{
+						if (r.u32_() != s.nonce)
+							continue;
+						const std::string why = r.str(120);
+						Log("the host refused us: " + why);
+						Osd("ps2net_lobby", "The host refused the connection: " + why, 30.0f);
+						s.ended = true;
+					}
+					else if (sid != s.session_id)
+						continue;
+					else if (type == PKT_START)
+					{
+						const u32 players = r.u8_();
+						const u32 delay = r.u8_();
+						std::array<u8, kMaxPlayers> slots;
+						for (u32 p = 0; p < kMaxPlayers; p++)
+							slots[p] = r.u8_();
+						std::array<std::string, kMaxPlayers> names;
+						for (u32 p = 0; p < kMaxPlayers; p++)
+							names[p] = r.str(16);
+						const u32 remaining = r.u32_();
+						if (!r.ok)
+							continue;
+						if (!s.started && !s.start_pending)
+						{
+							s.players = players;
+							s.delay = delay;
+							s.slots = slots;
+							s.names = names;
+							// Start together with the host: the host begins `remaining` ms after it sent this packet, which
+							// took about half a round trip to arrive.
+							std::vector<u32> r2 = s.rtts.empty() ? std::vector<u32>{s.rtt_ms} : s.rtts;
+							std::sort(r2.begin(), r2.end());
+							const double one_way = r2[r2.size() / 2] / 2.0;
+							s.start_at = NowMs() + std::max(0.0, remaining - one_way);
+							s.start_pending = true;
+							Log(fmt::format("start: {} players, delay {} frames, I am player {}; begin in {:.0f} ms (one way about {:.0f} ms)",
+								players, delay, s.me + 1, s.start_at - NowMs(), one_way));
+						}
+						Writer w = Header(s, PKT_STARTACK);
+						SendTo(s, s.host_addr, w);
+					}
+					else if (type == PKT_SET && s.started)
+						HandleSet(s, r);
+					else if (type == PKT_BYE)
+					{
+						Log("the host ended the session");
+						Osd("ps2net_lobby", "The host left. The online game is over.", 30.0f);
+						s.ended = true;
+					}
+				}
+			}
+			if (s.cfg.host && s.forward && s.started)
+			{
+				s.forward = false;
+				SendSets(s);
+			}
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Local input: this PC's controller, or a bot for tests
+		PadInput ParseButtons(const std::vector<std::string_view>& words, size_t from)
+		{
+			PadInput in = NeutralInput();
+			u16 buttons = 0xFFFF;
+			static constexpr std::pair<const char*, int> kBits[] = {{"L2", 0}, {"R2", 1}, {"L1", 2}, {"R1", 3},
+				{"TRI", 4}, {"O", 5}, {"X", 6}, {"SQ", 7}, {"SELECT", 8}, {"L3", 9}, {"R3", 10}, {"START", 11},
+				{"UP", 12}, {"RIGHT", 13}, {"DOWN", 14}, {"LEFT", 15}};
+			// pressure byte index in the report for buttons 0..15 (see PadDualshock2::BuildReport)
+			static constexpr int kPressure[16] = {16, 17, 14, 15, 10, 11, 12, 13, -1, -1, -1, -1, 8, 6, 9, 7};
+			for (size_t i = from; i < words.size(); i++)
+			{
+				const std::string w = StringUtil::toUpper(words[i]);
+				if (w.rfind("LX=", 0) == 0 || w.rfind("LY=", 0) == 0 || w.rfind("RX=", 0) == 0 || w.rfind("RY=", 0) == 0)
+				{
+					const u8 v = static_cast<u8>(std::min<u32>(StringUtil::FromChars<u32>(w.substr(3)).value_or(127), 255));
+					const int idx = (w[0] == 'L') ? (w[1] == 'X' ? 4 : 5) : (w[1] == 'X' ? 2 : 3);
+					in.report[idx] = v;
+					continue;
+				}
+				if (w == "ANALOG")
+				{
+					in.flags |= FLAG_ANALOG_BUTTON;
+					continue;
+				}
+				for (const auto& [name, bit] : kBits)
+				{
+					if (w == name)
+					{
+						buttons &= ~(1u << bit);
+						if (kPressure[bit] >= 0)
+							in.report[kPressure[bit]] = 0xFF;
+					}
+				}
+			}
+			in.report[0] = static_cast<u8>(buttons >> 8);
+			in.report[1] = static_cast<u8>(buttons & 0xFF);
+			return in;
+		}
+
+		void LoadScript(Session& s)
+		{
+			if (s.cfg.script.empty())
+				return;
+			const std::optional<std::string> text = FileSystem::ReadFileToString(s.cfg.script.c_str());
+			if (!text)
+			{
+				Log("cannot read bot script " + s.cfg.script);
+				return;
+			}
+			// line: <frame> <number of frames> <buttons...>   e.g. "600 4 START" or "900 30 LX=255 X"
+			for (const std::string_view raw : StringUtil::SplitString(*text, '\n', true))
+			{
+				const std::string_view line = StringUtil::StripWhitespace(raw);
+				if (line.empty() || line[0] == '#' || line[0] == ';')
+					continue;
+				std::vector<std::string_view> words = StringUtil::SplitString(line, ' ', true);
+				if (words.size() < 2)
+					continue;
+				const u32 f = StringUtil::FromChars<u32>(words[0]).value_or(0);
+				const u32 n = StringUtil::FromChars<u32>(words[1]).value_or(1);
+				s.script.push_back({{f, f + n}, ParseButtons(words, 2)});
+				s.script_end = std::max(s.script_end, f + n);
+			}
+			Log(fmt::format("bot script: {} lines, ends at frame {}", s.script.size(), s.script_end));
+		}
+
+		PadInput RandomInput(const Session& s, u32 frame)
+		{
+			// Holds a random combination for 6-20 frames, then changes. START/SELECT/ANALOG are never pressed
+			// (pause menus would stop a long test). Same seed, player and frame always give the same input.
+			std::mt19937 seg_rng(s.cfg.bot_seed * 7919u + s.me * 104729u + (frame / 6) * 2654435761u);
+			const u32 len = 6 + seg_rng() % 15;
+			std::mt19937 rng(s.cfg.bot_seed * 7919u + s.me * 104729u + (frame / len) * 2246822519u);
+			std::vector<std::string_view> words;
+			static constexpr const char* kPool[] = {"X", "O", "SQ", "TRI", "L1", "R1", "L2", "R2", "UP", "DOWN", "LEFT", "RIGHT"};
+			const u32 k = rng() % 3;
+			for (u32 i = 0; i < k; i++)
+				words.push_back(kPool[rng() % std::size(kPool)]);
+			PadInput in = ParseButtons(words, 0);
+			in.report[4] = static_cast<u8>(rng() % 256);
+			in.report[5] = static_cast<u8>(rng() % 256);
+			return in;
+		}
+
+		PadInput LiveInput()
+		{
+			PadBase* pad = Pad::GetPad(0);
+			if (!pad || pad->GetType() != Pad::ControllerType::DualShock2)
+				return NeutralInput();
+			PadInput in{};
+			static_cast<PadDualshock2*>(pad)->BuildReport(in.report);
+			if (pad->GetRawInput(PadDualshock2::Inputs::PAD_ANALOG) > 0)
+				in.flags |= FLAG_ANALOG_BUTTON;
+			return in;
+		}
+
+		PadInput LocalInput(Session& s, u32 frame)
+		{
+			if (s.cfg.bot == "random")
+				return RandomInput(s, frame);
+			if (s.cfg.bot == "script")
+			{
+				if (frame < s.script_end || s.cfg.bot_then == "idle")
+				{
+					for (const auto& [range, in] : s.script)
+						if (frame >= range.first && frame < range.second)
+							return in;
+					return NeutralInput();
+				}
+				if (s.cfg.bot_then == "random")
+					return RandomInput(s, frame);
+			}
+			return LiveInput();
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Waiting (lobby and per frame). Keeps the window responsive and the on-screen messages visible.
+		bool KeepWaiting(Session& s, double started_ms, double& last_present_ms)
+		{
+			Host::PumpMessagesOnCPUThread();
+			if (VMManager::GetState() == VMState::Stopping)
+			{
+				Log("emulator is stopping, leaving the session");
+				s.ended = true;
+				return false;
+			}
+			const double now = NowMs();
+			if (now - started_ms > 300.0 && now - last_present_ms > 100.0)
+			{
+				MTGS::PresentCurrentFrame();
+				last_present_ms = now;
+			}
+			WaitForPacket(s, 2);
+			return !s.ended;
+		}
+
+		void RunLobby(Session& s)
+		{
+			const double t0 = NowMs();
+			double last_present = 0, last_hello = 0, last_start = 0, last_osd = 0;
+			Log(fmt::format("screen: {}", ScreenName(s.cfg.screen)));
+			Log(fmt::format("lobby: {} on port {}, {} player(s), disc {} {:08X}, BIOS checksum {:08X}, settings {:016x}, memory card {:016x}",
+				s.cfg.host ? "hosting" : fmt::format("joining {}", s.cfg.host_address), s.cfg.port, s.cfg.players,
+				VMManager::GetDiscSerial(), VMManager::GetDiscCRC(), BiosChecksum, s.fingerprint, s.mcd_hash));
+			Log("settings that must match:\n" + s.fingerprint_listing);
+			if (s.cfg.host && s.cfg.players <= 1)
+			{
+				s.started = true;
+				return;
+			}
+			while (!s.started)
+			{
+				Receive(s);
+				const double now = NowMs();
+				if (s.cfg.host)
+				{
+					const bool all_here = s.peers.size() + 1 >= s.players;
+					// measure every friend's connection for about 3 seconds (a hello every 250 ms) before choosing the delay
+					const bool rtt_known = std::all_of(s.peers.begin(), s.peers.end(), [](const Peer& p) { return p.rtts.size() >= 10 || p.hellos >= 20; });
+					if (all_here && rtt_known)
+					{
+						if (s.delay == 0)
+						{
+							// Protocol 4: an input travels one way (friend -> host, host -> friend, or friend -> host ->
+							// friend), and all PCs start at the same moment, so the delay covers a one-way trip, not a
+							// round trip. The 90 % value of the measured round trips ignores a single lucky/unlucky sample.
+							std::vector<u32> p90s;
+							for (const Peer& p : s.peers)
+							{
+								std::vector<u32> r = p.rtts.empty() ? std::vector<u32>{p.rtt_ms} : p.rtts;
+								std::sort(r.begin(), r.end());
+								p90s.push_back(r[std::min<size_t>(r.size() - 1, (r.size() * 9) / 10)]);
+							}
+							std::sort(p90s.rbegin(), p90s.rend());
+							const u32 worst = p90s.empty() ? 0 : p90s[0];
+							// two friends: friend A -> host -> friend B = both one-way trips
+							const double need = p90s.size() >= 2 ? (p90s[0] + p90s[1]) / 2.0 : worst / 2.0;
+							u32 delay = static_cast<u32>((need + 16.68) / 16.68) + 1;
+							// "Smooth": over the internet (not the same house) add 3 frames = 50 ms, so the common small
+							// delays do not pause the game (user test 2026-11-05: average pause 52 ms).
+							const bool internet = worst >= 20;
+							if (s.cfg.smooth && internet)
+								delay += 3;
+							s.delay = std::clamp<u32>(delay, 3, 20);
+							s.start_at = now + std::max(500.0, 3.0 * worst);
+							Log(fmt::format("round trip (90 %) worst {} ms, one-way path {:.0f} ms, {} -> input delay {} frames ({} ms)",
+								worst, need, s.cfg.smooth ? (internet ? "smooth, internet" : "smooth, same house") : "fast", s.delay,
+								static_cast<u32>(s.delay * 16.68)));
+						}
+						if (now - last_start > 100.0)
+						{
+							for (const Peer& p : s.peers)
+								SendStart(s, p.addr);
+							last_start = now;
+						}
+						if (now >= s.start_at && std::all_of(s.peers.begin(), s.peers.end(), [](const Peer& p) { return p.started; }))
+						{
+							s.started = true;
+							Log(fmt::format("start: {} players, delay {} frames", s.players, s.delay));
+						}
+					}
+					if (now - last_osd > 1000.0)
+					{
+						Osd("ps2net_lobby", fmt::format("Hosting on port {}. Players: {} of {}. Waiting...", s.cfg.port,
+							s.peers.size() + 1, s.players), 2.0f);
+						last_osd = now;
+					}
+				}
+				else
+				{
+					if (s.start_pending)
+					{
+						if (now >= s.start_at)
+							s.started = true;
+					}
+					else if (now - last_hello > 250.0)
+					{
+						SendHello(s);
+						last_hello = now;
+					}
+					if (s.session_id == 0 && now - last_osd > 1000.0)
+					{
+						Osd("ps2net_lobby", fmt::format("Connecting to {} port {}... ({} s)", s.cfg.host_address, s.cfg.port,
+							static_cast<int>((now - t0) / 1000.0)), 2.0f);
+						last_osd = now;
+					}
+				}
+				if (!KeepWaiting(s, t0, last_present))
+					return;
+			}
+			Host::RemoveKeyedOSDMessage("ps2net_lobby");
+			Osd("ps2net_start", fmt::format("Online game started: {} players, you are player {}. Input delay {} frames ({:.2f} s).",
+				s.players, s.me + 1, s.delay, s.delay * 16.68 / 1000.0), 8.0f);
+			s.last_rx_ms = NowMs();
+			for (Peer& p : s.peers)
+				p.last_rx_ms = NowMs();
+		}
+
+		// ------------------------------------------------------------------------------------------------------
+		// Memory hash: 1/64 of EE RAM (+ 1/64 of IOP RAM) each frame; one digest per 64 frames.
+		void HashStep(Session& s, u32 frame)
+		{
+			const u32 chunk = frame % kChunks;
+			const size_t ee = Ps2MemSize::MainRam / kChunks;
+			const size_t iop = Ps2MemSize::IopRam / kChunks;
+			u64 h = HashBytes(0x4545ull + chunk, eeMem->Main + chunk * ee, ee);
+			h = HashBytes(h, iopMem->Main + chunk * iop, iop);
+			s.chunk_hash[chunk] = h;
+			s.block_hash = Mix(s.block_hash, h);
+			if (chunk == kChunks - 1)
+			{
+				const u32 block = frame / kChunks;
+				s.my_digests.push_back({block, s.block_hash});
+				s.my_chunks.push_back({block, s.chunk_hash});
+				while (s.my_digests.size() > 64)
+					s.my_digests.pop_front();
+				while (s.my_chunks.size() > 16)
+					s.my_chunks.pop_front();
+				s.report_block = block;
+				s.report_digest = s.block_hash;
+				s.block_hash = 0;
+			}
+		}
+
+		void ShowDesync(Session& s)
+		{
+			if (s.desync_block == kNone || s.desync_logged)
+				return;
+			s.desync_logged = true;
+			const u32 frame = s.desync_block * kChunks;
+			Log(fmt::format("OUT OF SYNC detected (player {} differs) in frames {}-{}", s.desync_player + 1, frame, frame + kChunks - 1));
+			for (const auto& [block, chunks] : s.my_chunks)
+			{
+				if (block != s.desync_block)
+					continue;
+				std::string line = fmt::format("my chunk hashes for block {}:", block);
+				for (u32 c = 0; c < kChunks; c++)
+					line += fmt::format(" {:016x}", chunks[c]);
+				Log(line);
+			}
+			Osd("ps2net_desync", fmt::format("OUT OF SYNC with player {} (since about frame {}). The PCs no longer show the same game.",
+				s.desync_player + 1, frame), 30.0f);
+		}
+
+		void HostDropCheck(Session& s, u32 frame)
+		{
+			if (s.cfg.drop_after_s == 0)
+				return;
+			const double now = NowMs();
+			for (u32 k = 0; k < s.peers.size(); k++)
+			{
+				Peer& p = s.peers[k];
+				if (p.dropped || now - p.last_rx_ms < s.cfg.drop_after_s * 1000.0)
+					continue;
+				const u32 player = k + 1;
+				p.dropped = true;
+				s.dropped_from[player] = frame;
+				for (u32 f = frame; f < frame + kRing / 2; f++)
+				{
+					FrameSlot& fs = s.ring[f % kRing];
+					if (fs.frame == f)
+						fs.dropped |= static_cast<u8>(1u << player);
+				}
+				Log(fmt::format("player {} '{}' did not answer for {} s: dropped from frame {} (controller released)", player + 1,
+					p.name, s.cfg.drop_after_s, frame));
+				Osd("ps2net_drop", fmt::format("{} (player {}) lost connection and was removed.", p.name, player + 1), 10.0f);
+			}
+		}
+
+		void ApplyFrame(Session& s, u32 frame)
+		{
+			const FrameSlot* fs = PeekSlot(frame);
+			for (u32 p = 0; p < kMaxPlayers; p++)
+			{
+				PadInput in = NeutralInput();
+				if (p < s.players && frame >= s.delay && fs && !(fs->dropped & (1u << p)))
+					in = fs->in[p];
+				s.cur[p] = in;
+				// Analog button: toggles the pad mode on the press, at this frame on every PC.
+				const bool pressed = (in.flags & FLAG_ANALOG_BUTTON) && !(s.prev_flags[p] & FLAG_ANALOG_BUTTON);
+				s.prev_flags[p] = in.flags;
+				if (pressed && p < s.players && s.slots[p] != kNoSlot)
+				{
+					PadBase* pad = Pad::GetPad(s.slots[p]);
+					if (pad && pad->GetType() == Pad::ControllerType::DualShock2)
+						static_cast<PadDualshock2*>(pad)->ToggleAnalogFromSession();
+				}
+			}
+		}
+
+		void TestHooks(Session& s, u32 frame)
+		{
+			const bool snap = (s.cfg.snap_every && frame % s.cfg.snap_every == 0 && frame) ||
+							  std::find(s.cfg.snap_frames.begin(), s.cfg.snap_frames.end(), frame) != s.cfg.snap_frames.end();
+			if (snap && !s.cfg.snap_dir.empty())
+			{
+				std::string path = Path::Combine(s.cfg.snap_dir, fmt::format("p{}_f{:06d}.png", s.me + 1, frame));
+				// The snapshot is the unchanged picture unless SnapView asks for what this PC shows.
+				const bool full = !s.cfg.snap_view;
+				MTGS::RunOnGSThread([path, full]() {
+					if (full)
+						GSPresentView::FullPictureOnce();
+					GSQueueSnapshot(path, 0);
+				});
+			}
+			if (!s.cfg.snap_dir.empty() &&
+				std::find(s.cfg.dump_frames.begin(), s.cfg.dump_frames.end(), frame) != s.cfg.dump_frames.end())
+			{
+				// Test only: the whole EE main memory at an exact session frame (read only).
+				const std::string dump_path = Path::Combine(s.cfg.snap_dir, fmt::format("p{}_ram_f{:06d}.bin", s.me + 1, frame));
+				if (std::FILE* f = FileSystem::OpenCFile(dump_path.c_str(), "wb"))
+				{
+					std::fwrite(eeMem->Main, 1, Ps2MemSize::MainRam, f);
+					std::fclose(f);
+				}
+			}
+			if (s.cfg.exit_at_frame && frame == s.cfg.exit_at_frame)
+			{
+				Log(fmt::format("test end at frame {}: hashes compared {}, desync block {}", frame, s.compared,
+					s.desync_block == kNone ? std::string("none") : std::to_string(s.desync_block)));
+				Host::RequestVMShutdown(false, false, false);
+			}
+		}
+
+		void Stats(Session& s)
+		{
+			const double now = NowMs();
+			if (now - s.last_stats_ms < 10000.0)
+				return;
+			s.last_stats_ms = now;
+			std::string polls;
+			for (u32 i = 0; i < 8; i++)
+				if (s_poll_bytes[i])
+					polls += fmt::format(" slot{}={}/{}", i, s_poll_bytes[i], s_poll_start[i]);
+			s_poll_bytes = {};
+			s_poll_start = {};
+			Log("polls (reply bytes / with START held):" + (polls.empty() ? std::string(" none") : polls));
+			if (!s.cfg.peek.empty())
+			{
+				std::string words;
+				for (u32 a : s.cfg.peek)
+					words += fmt::format(" {:08X}={:08X}", a, memRead32(a));
+				Log("peek:" + words);
+			}
+			Log(fmt::format("speed: game frames per second {:.1f}, PS2 vsyncs per second {:.1f}", PerformanceMetrics::GetInternalFPS(), PerformanceMetrics::GetFPS()));
+			Log(fmt::format("stats: frame {}, waits {}, wait total {:.0f} ms, longest {:.0f} ms, digests compared {}, rtt {} ms, {}",
+				s.frame, s.waits, s.wait_total_ms, s.wait_max_ms, s.compared, s.rtt_ms,
+				s.desync_block == kNone ? "in sync" : fmt::format("OUT OF SYNC since block {}", s.desync_block)));
+		}
+
+		void EndSession(bool say_bye)
+		{
+			if (!s_session)
+				return;
+			Session& s = *s_session;
+			if (say_bye && s.sock != INVALID_SOCKET)
+			{
+				Writer w = Header(s, PKT_BYE);
+				for (int i = 0; i < 3; i++)
+				{
+					if (s.cfg.host)
+						for (const Peer& p : s.peers)
+							RawSend(s, p.addr, w.b);
+					else
+						RawSend(s, s.host_addr, w.b);
+				}
+			}
+			Log(fmt::format("session closed at frame {} (digests compared {}, {})", s.frame, s.compared,
+				s.desync_block == kNone ? "never out of sync" : fmt::format("out of sync since block {}", s.desync_block)));
+			if (s.sock != INVALID_SOCKET)
+				closesocket(s.sock);
+			s_session.reset();
+		}
+	} // namespace
+
+	void OverrideCoreSettings(Pcsx2Config& cfg)
+	{
+		LoadConfig();
+		if (!s_cfg.enabled)
+			return;
+		// Multi-threaded VU1 lets host thread timing reach the game. HYPOTHESIS: off is needed; measure the cost.
+		cfg.Speedhacks.vuThread = false;
+		// The BIOS reads the PC clock. Every PC uses the same fixed date and time instead.
+		cfg.ManuallySetRealTimeClock = true;
+		cfg.RtcYear = 4;
+		cfg.RtcMonth = 9;
+		cfg.RtcDay = 3;
+		cfg.RtcHour = 12;
+		cfg.RtcMinute = 0;
+		cfg.RtcSecond = 0;
+		cfg.EnableCheats = false;
+		// Screen shape: the widescreen patches change the game's camera, so the host's choice applies to every PC.
+		cfg.EnableWideScreenPatches = (s_cfg.screen == 1);
+		// Controllers: exactly the session's slots are DualShock 2, everything else is unplugged.
+		bool port0_tap = false, port1_tap = false;
+		for (u32 p = 0; p < kMaxPlayers; p++)
+		{
+			const u8 slot = s_cfg.slots[p];
+			if (slot == kNoSlot)
+				continue;
+			port0_tap |= (slot >= 2 && slot <= 4);
+			port1_tap |= (slot >= 5);
+		}
+		cfg.Pad.MultitapPort0_Enabled = port0_tap;
+		cfg.Pad.MultitapPort1_Enabled = port1_tap;
+		for (u32 i = 0; i < Pad::NUM_CONTROLLER_PORTS; i++)
+		{
+			const bool used = std::find(s_cfg.slots.begin(), s_cfg.slots.end(), static_cast<u8>(i)) != s_cfg.slots.end();
+			cfg.Pad.Ports[i].Type = used ? Pad::ControllerType::DualShock2 : Pad::ControllerType::NotConnected;
+		}
+		// Pad 1 (slot 0) also carries this PC's own controller bindings, so it must stay a DualShock 2.
+		cfg.Pad.Ports[0].Type = Pad::ControllerType::DualShock2;
+	}
+
+	bool IsActive()
+	{
+		LoadConfig();
+		return s_cfg.enabled && !(s_session && s_session->ended);
+	}
+
+	bool GetSlotReport(u32 unified_slot, u8 out[REPORT_SIZE])
+	{
+		if (!IsActive())
+			return false;
+		if (!s_session || !s_session->started)
+		{
+			const PadInput n = NeutralInput();
+			std::memcpy(out, n.report, REPORT_SIZE);
+			return true;
+		}
+		const Session& s = *s_session;
+		for (u32 p = 0; p < kMaxPlayers; p++)
+		{
+			if (s.slots[p] == unified_slot)
+			{
+				std::memcpy(out, s.cur[p].report, REPORT_SIZE);
+				if (unified_slot < 8)
+				{
+					s_poll_bytes[unified_slot]++;
+					if (!(out[0] & 0x08)) // START = button bit 11, active low
+						s_poll_start[unified_slot]++;
+				}
+				return true;
+			}
+		}
+		const PadInput n = NeutralInput();
+		std::memcpy(out, n.report, REPORT_SIZE);
+		return true;
+	}
+
+	void OnFramePush()
+	{
+		GSPresentView::State want;
+		u32 who = 0, frame = 0;
+		if (s_session && !s_session->ended && s_session->started && s_view.loaded && s_session->cfg.view != 0xFF)
+		{
+			const Session& s = *s_session;
+			frame = s.frame;
+			who = s.cfg.view ? (s.cfg.view - 1u) : s.me;
+			// The bytes as the game has them now; what is on display may be the picture of LayoutDelay frames ago.
+			for (u32 i = 3; i > 0; i--)
+			{
+				s_view_layout_hist[i] = s_view_layout_hist[i - 1];
+				s_view_owner_hist[i] = s_view_owner_hist[i - 1];
+			}
+			s_view_layout_hist[0] = static_cast<u8>(s_view.layout_addr ? memRead8(s_view.layout_addr) : s_view.test_layout);
+			s_view_owner_hist[0] = static_cast<u8>(s_view.owner_addr ? memRead8(s_view.owner_addr) : (s.frame & 1u));
+			const u32 layout = s_view_layout_hist[s_view.layout_delay];
+			want.in_screenshots = s.cfg.snap_view;
+			// The marker of the full-size layout can arrive before its layout value is used here: always known.
+			// Each PC waits for its own player's marker; a PC whose player has none shows the final picture.
+			const u32 my_marker = (who < kMaxPlayers) ? s_view.marker_ids[who] : 0;
+			want.marker_id = my_marker;
+			want.marker_all_id = s_view.marker_all_id;
+			want.keep_save_id = s_view.keep_save_id;
+			want.keep_restore_id = s_view.keep_restore_id;
+			want.keep_restore_bp = s_view.keep_restore_bp;
+			want.marker_hold = s_view.marker_hold;
+			want.marker_shown_buffer = s_view.marker_shown_buffer;
+			want.show_copy = (my_marker != 0);
+			if (layout != 0 && layout == s_view.side_value)
+			{
+				if (who < kMaxPlayers && s_view.rect[who].set)
+				{
+					want.kind = 1;
+					want.left = s_view.rect[who].l;
+					want.top = s_view.rect[who].t;
+					want.right = s_view.rect[who].r;
+					want.bottom = s_view.rect[who].b;
+				}
+			}
+			else if (layout != 0 && layout == s_view.marker_value)
+			{
+				want.kind = 2;
+				want.fake_after_draws = s_view.marker_test_draws;
+				want.fake_every = s_view.marker_test_every;
+			}
+			else if (layout != 0 && layout == s_view.alternate_value)
+			{
+				want.kind = 3;
+				const u32 owner = s_view_owner_hist[s_view.layout_delay];
+				want.mine = (owner == who) || owner >= kMaxPlayers;
+			}
+			if (want.kind == 0)
+				want.in_screenshots = false;
+		}
+		PostView(want, frame, who);
+	}
+
+	void OnVsync()
+	{
+		LoadConfig();
+		if (!s_cfg.enabled)
+			return;
+		if (!s_session)
+		{
+			// First frame after power-on: open the network and wait until every player is there.
+			// Everything the PS2 did before this point is the same on every PC (same disc, BIOS, settings, card).
+			auto s = std::make_unique<Session>();
+			s->cfg = s_cfg;
+			s->players = s_cfg.host ? s_cfg.players : 1;
+			s->delay = s_cfg.delay;
+			s->slots = s_cfg.slots;
+			s->names[0] = s_cfg.name;
+			std::random_device rd;
+			s->nonce = rd() | 1u;
+			s->session_id = s_cfg.host ? (rd() | 1u) : 0;
+			s->fingerprint = SettingsFingerprint(EmuConfig, &s->fingerprint_listing);
+			s->mcd_hash = MemcardHash();
+			s->patch_hash = PatchFilesHash();
+			s->rng.seed(s->nonce);
+			for (PadInput& in : s->cur)
+				in = NeutralInput();
+			s_session = std::move(s);
+			LoadViewSettings();
+			Session& ss = *s_session;
+			LoadScript(ss);
+			std::string error;
+			if (!OpenSocket(ss, &error))
+			{
+				Log("network error: " + error);
+				Osd("ps2net_lobby", "Online game cannot start: " + error, 30.0f);
+				ss.ended = true;
+				return;
+			}
+			RunLobby(ss);
+			if (ss.ended)
+				return;
+		}
+		Session& s = *s_session;
+		if (s.ended)
+		{
+			// Test runs (ExitAtFrame set) close the emulator when the session ends early, e.g. the host left first.
+			if (s.cfg.exit_at_frame && !s.exit_requested)
+			{
+				s.exit_requested = true;
+				Host::RequestVMShutdown(false, false, false);
+			}
+			return;
+		}
+
+		const u32 frame = s.frame;
+		// 1. This PC's input for frame + delay.
+		{
+			FrameSlot& fs = Slot(frame + s.delay);
+			fs.in[s.me] = LocalInput(s, frame + s.delay);
+			fs.have[s.me] = true;
+			if (!s.cfg.host)
+				AdvanceClientAck(s);
+			if (s.cfg.host)
+				for (u32 p = 1; p < s.players; p++)
+					if (frame + s.delay >= s.dropped_from[p])
+						fs.dropped |= static_cast<u8>(1u << p);
+		}
+		// 2. Exchange, then wait for the complete frame.
+		Receive(s);
+		if (s.cfg.host)
+			SendSets(s);
+		else
+			SendInputs(s);
+		const auto ready = [&]() {
+			if (frame < s.delay)
+				return true;
+			return AllInputsKnown(s, frame);
+		};
+		if (!ready())
+		{
+			const double t0 = NowMs();
+			double last_present = 0, last_osd = 0;
+			while (!ready())
+			{
+				Receive(s);
+				const double now = NowMs();
+				if (now - s.last_send_ms > 15.0)
+				{
+					if (s.cfg.host)
+						SendSets(s);
+					else
+						SendInputs(s);
+				}
+				if (s.cfg.host)
+					HostDropCheck(s, frame);
+				if (now - t0 > 1000.0 && now - last_osd > 500.0)
+				{
+					std::string who;
+					if (s.cfg.host)
+					{
+						const FrameSlot* fs = PeekSlot(frame);
+						for (u32 p = 1; p < s.players; p++)
+							if (!(fs && (fs->have[p] || (fs->dropped & (1u << p)))))
+								who += fmt::format(" {} (player {})", s.peers[p - 1].name, p + 1);
+					}
+					else
+					{
+						const FrameSlot* fs = PeekSlot(frame);
+						for (u32 p = 0; p < s.players; p++)
+							if (p != s.me && !(fs && (fs->have[p] || (fs->dropped & (1u << p)))))
+								who += fmt::format(" {} (player {})", s.names[p], p + 1);
+					}
+					Osd("ps2net_wait", fmt::format("Waiting for{}... {} s", who, static_cast<int>((now - t0) / 1000.0)), 1.0f);
+					last_osd = now;
+				}
+				if (!s.cfg.host && now - s.last_rx_ms > 30000.0)
+				{
+					Log("no packet from the host for 30 s; leaving the session");
+					Osd("ps2net_wait", "Lost the connection to the host. The online game is over.", 30.0f);
+					s.ended = true;
+				}
+				if (!KeepWaiting(s, t0, last_present))
+					return;
+			}
+			const double waited = NowMs() - t0;
+			s.waits++;
+			s.wait_total_ms += waited;
+			s.wait_max_ms = std::max(s.wait_max_ms, waited);
+		}
+		// 3. Use it: every PC applies the same inputs at the same emulated moment.
+		ApplyFrame(s, frame);
+		if (s.cfg.host)
+			SendSets(s); // the frame just completed may be new for the clients
+		HashStep(s, frame);
+		if (s.cfg.host)
+			CompareReports(s);
+		ShowDesync(s);
+		TestHooks(s, frame);
+		Stats(s);
+		if (frame % 300 == 150)
+		{
+			// Settings that change during the game (user opened the settings, or per-game settings arrived) are
+			// logged; they only matter if they differ between PCs, which the memory hashes then show.
+			std::string listing;
+			const u64 fp = SettingsFingerprint(EmuConfig, &listing);
+			if (fp != s.fingerprint)
+			{
+				Log(fmt::format("note: emulator settings changed at frame {} (fingerprint {:016x} -> {:016x}):\n{}", frame,
+					s.fingerprint, fp, listing));
+				s.fingerprint = fp;
+			}
+		}
+		s.frame++;
+	}
+
+	void OnVMShutdown()
+	{
+		EndSession(true);
+		PostView(GSPresentView::State(), 0, 0);
+		s_view = ViewSettings();
+		if (s_log)
+		{
+			std::fclose(s_log);
+			s_log = nullptr;
+		}
+	}
+} // namespace PS2Net
diff --git a/pcsx2/PS2Net/PS2Net.h b/pcsx2/PS2Net/PS2Net.h
new file mode 100644
