+// PS2Net: the poll reply bytes 3..20 for this PC's live input, exactly what Poll() returned before.
+void PadDualshock2::BuildReport(u8 out[18]) const
+{
+	const u32 b = GetButtons();
+	out[0] = (b >> 8) & 0xff;
+	out[1] = b & 0xff;
+	out[2] = GetPressure(Inputs::PAD_R_RIGHT);
+	out[3] = GetPressure(Inputs::PAD_R_UP);
+	out[4] = GetPressure(Inputs::PAD_L_RIGHT);
+	out[5] = GetPressure(Inputs::PAD_L_UP);
+	out[6] = IsButtonBitSet(b, 13) ? GetPressure(Inputs::PAD_RIGHT) : 0;
+	out[7] = IsButtonBitSet(b, 15) ? GetPressure(Inputs::PAD_LEFT) : 0;
+	out[8] = IsButtonBitSet(b, 12) ? GetPressure(Inputs::PAD_UP) : 0;
+	out[9] = IsButtonBitSet(b, 14) ? GetPressure(Inputs::PAD_DOWN) : 0;
+	out[10] = IsButtonBitSet(b, 4) ? GetPressure(Inputs::PAD_TRIANGLE) : 0;
+	out[11] = IsButtonBitSet(b, 5) ? GetPressure(Inputs::PAD_CIRCLE) : 0;
+	out[12] = IsButtonBitSet(b, 6) ? GetPressure(Inputs::PAD_CROSS) : 0;
+	out[13] = IsButtonBitSet(b, 7) ? GetPressure(Inputs::PAD_SQUARE) : 0;
+	out[14] = IsButtonBitSet(b, 2) ? GetPressure(Inputs::PAD_L1) : 0;
+	out[15] = IsButtonBitSet(b, 3) ? GetPressure(Inputs::PAD_R1) : 0;
+	out[16] = IsButtonBitSet(b, 0) ? GetPressure(Inputs::PAD_L2) : 0;
+	out[17] = IsButtonBitSet(b, 1) ? GetPressure(Inputs::PAD_R2) : 0;
+}
+
+// PS2Net: the Analog button of an online player, applied at the same emulated frame on every PC.
+void PadDualshock2::ToggleAnalogFromSession()
+{
+	if (this->analogLocked)
+		return;
+	this->analogLight = !this->analogLight;
+	this->currentMode = this->analogLight ? Pad::Mode::ANALOG : Pad::Mode::DIGITAL;
+	const auto [port, slot] = sioConvertPadToPortAndSlot(unifiedSlot);
+	Host::AddKeyedOSDMessage(fmt::format("PadAnalogButtonChange{}{}", port, slot),
+		this->analogLight ? fmt::format(TRANSLATE_FS("Pad", "Analog light is now on for port {0} / slot {1}"), port + 1, slot + 1) :
+							fmt::format(TRANSLATE_FS("Pad", "Analog light is now off for port {0} / slot {1}"), port + 1, slot + 1),
+		Host::OSD_INFO_DURATION);
+}
+
 bool PadDualshock2::IsAnalogLightEnabled() const
 {
 	return this->analogLight;
