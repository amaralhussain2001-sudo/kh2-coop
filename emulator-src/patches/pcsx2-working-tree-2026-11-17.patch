--- /dev/null
+++ b/pcsx2/PS2Net/PS2Net.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0+
+// PS2Net: plays a game's own local multiplayer (several controllers / multitap) online, in lockstep.
+// Not part of upstream PCSX2. Off unless the environment variable PS2NET_CONFIG names a session INI file.
+
+#pragma once
+
+#include "common/Pcsx2Types.h"
+
+
+struct Pcsx2Config;
+
+namespace PS2Net
+{
+	// Size of the reply a DualShock 2 sends for a poll after the 3 header bytes:
+	// buttons (2), right stick x/y, left stick x/y, 12 pressure values.
+	static constexpr u32 REPORT_SIZE = 18;
+
+	// Called from VMManager::LoadCoreSettings after the settings were read.
+	// Forces the settings every PC in a session must share (multitap, controller types, clock, MTVU off).
+	void OverrideCoreSettings(Pcsx2Config& cfg);
+
+	// True while a session runs: emulated controllers then report the synced inputs, not this PC's live input.
+	bool IsActive();
+
+	// Once per emulated frame, right after the host input was polled (Counters.cpp VSyncStart).
+	// Sends this PC's input and waits until every player's input for the current frame is known.
+	void OnVsync();
+
+	// Once per emulated frame, right BEFORE the finished picture is handed to the GS thread (Counters.cpp
+	// VSyncStart). Own-screen view: tells the GS thread what this PC shows of the picture. Display only.
+	void OnFramePush();
+
+	// Called by the DualShock 2 poll handler. Returns false when the slot is not driven by the session.
+	bool GetSlotReport(u32 unified_slot, u8 out[REPORT_SIZE]);
+
+	// VM shutdown: ends the session and closes the socket.
+	void OnVMShutdown();
+} // namespace PS2Net
